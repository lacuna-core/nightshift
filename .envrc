# direnv (https://direnv.net), optional: loads the project environment when you cd into
# the repo. After changing this file, run `direnv allow` again.

# LACUNA_* settings (copy .env.example to .env first).
dotenv_if_exists .env

# Tools from the uv virtualenv (pytest, ruff, mypy, lacuna) without `uv run`.
PATH_add .venv/bin

# Personal additions that should not be committed.
source_env_if_exists .envrc.local
